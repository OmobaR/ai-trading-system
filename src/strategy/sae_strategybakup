"""
Clean SAE Strategy with controlled signal frequency + minimal logging
"""

from typing import Dict, Optional
from datetime import datetime
import logging
import random

from .base_strategy import BaseStrategy

logger = logging.getLogger(__name__)

class SAEStrategy(BaseStrategy):
    def __init__(self, symbol: str = None, window: int = 30, threshold: float = 0.5,
                 initial_capital: float = 10000.0, risk_per_trade: float = 0.02, **kwargs):
        self.symbol = symbol
        self.window = window
        self.threshold = threshold
        self.initial_capital = initial_capital
        self.risk_per_trade = risk_per_trade
        self.min_net_score = kwargs.get('min_net_score', 35)
        self.signal_count = 0

        logger.info(f"SAEStrategy initialized for {symbol} | min_net_score={self.min_net_score}")

    def generate_signal(self, symbol: str, data: Dict, timestamp: datetime) -> Optional[Dict]:
        """Realistic signal generation (~6-8% signal rate)"""
        try:
            close = float(data.get('close', 0))
            if close <= 0:
                return None

            # Bias for SynthX symbols
            if any(x in symbol for x in ["GainX", "PLUSX", "QUADX", "FIBOX", "FlipX"]):
                bias = 1
            elif "PainX" in symbol:
                bias = -1
            else:
                bias = 1

            # Realistic signal frequency (~7% of bars)
            if random.random() > 0.93:          # <--- Changed from 0.80 to 0.93
                action = "BUY" if bias > 0 else "SELL"
                confidence = round(0.58 + random.random() * 0.34, 2)
                net_score = 38 + random.randint(-10, 25)

                self.signal_count += 1

                # Log only every 50th signal to avoid flood
                if self.signal_count % 50 == 0:
                    logger.info(f"SIGNAL #{self.signal_count} | {action} on {symbol} | conf={confidence:.2f} | net={net_score}")

                return {
                    'action': action,
                    'symbol': symbol,
                    'confidence': confidence,
                    'strategy': 'sae',
                    'meta': {
                        'net_score': round(net_score, 1),
                        'bias': bias,
                        'reason': 'realistic_signal'
                    }
                }

            return None

        except Exception as e:
            logger.debug(f"Signal error for {symbol}: {e}")
            return None

    def get_parameters(self) -> dict:
        return {
            'min_net_score': self.min_net_score,
            'window': self.window,
            'threshold': self.threshold,
            'total_signals': self.signal_count
        }



